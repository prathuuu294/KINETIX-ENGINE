  <script>
    // 1. Switch Interactive Sandbox Tabs
    function switchTab(tabName, btnElement) {
      document.querySelectorAll('.preview-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));

      document.getElementById('tab-' + tabName).classList.add('active');
      btnElement.classList.add('active');
    }

    // 2. Pre-select Plan & Scroll to Form
    function selectPlan(planTitle) {
      const select = document.getElementById('selectedPlan');
      select.value = planTitle;
      document.getElementById('commission').scrollIntoView({ behavior: 'smooth' });
    }

    // 3. Manage Business Leads in LocalStorage (Built-In Admin CRM)
    const STORAGE_KEY = 'salunke_studio_india_leads';

    function getLeads() {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) {
        // Default sample Indian lead so CRM never looks empty on first open
        const sample = [{
          name: "Vikramaditya Singhania",
          business: "Singhania Luxe Estates",
          phone: "+91 98201 11223",
          city: "Mumbai, MH",
          plan: "Business CRM & Portal Suite (₹64,999)",
          notes: "Need custom property ROI calculator + VIP buyer login portal.",
          date: "Sample Lead"
        }];
        localStorage.setItem(STORAGE_KEY, JSON.stringify(sample));
        return sample;
      }
      return JSON.parse(raw);
    }

    function submitLead(event) {
      event.preventDefault();
      const newLead = {
        name: document.getElementById('clientName').value,
        business: document.getElementById('businessName').value,
        phone: document.getElementById('clientPhone').value,
        city: document.getElementById('clientCity').value,
        plan: document.getElementById('selectedPlan').value,
        notes: document.getElementById('clientNotes').value || "Standard deployment requested.",
        date: new Date().toLocaleDateString('en-IN')
      };

      const leads = getLeads();
      leads.unshift(newLead);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(leads));

      event.target.reset();
      renderLeads();
      toggleCRM(); // Open CRM modal immediately to show the saved inquiry
    }

    function renderLeads() {
      const leads = getLeads();
      document.getElementById('leadCount').innerText = leads.length;
      const container = document.getElementById('leadsContainer');

      if (leads.length === 0) {
        container.innerHTML = `<p style="color: var(--text-muted);">No inquiries yet. Submit the form on the page to test your CRM.</p>`;
        return;
      }

      container.innerHTML = leads.map(lead => `
        <div class="lead-item">
          <div>
            <strong style="font-size: 1.05rem; color: var(--gold-light);">${lead.business}</strong>
            <span class="india-badge mono" style="margin-left: 8px;">${lead.city}</span>
            <p style="font-size: 0.88rem; color: var(--text-main); margin-top: 4px;">
              Client: ${lead.name} • Phone: <span class="mono">${lead.phone}</span>
            </p>
            <p style="font-size: 0.82rem; color: var(--text-muted); margin-top: 4px;">
              Note: ${lead.notes}
            </p>
          </div>
          <div style="text-align: right;">
            <span class="card-code mono">${lead.plan}</span>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">${lead.date}</div>
          </div>
        </div>
      `).join('');
    }

    function toggleCRM() {
      document.getElementById('crmModal').classList.toggle('open');
      renderLeads();
    }

    function clearLeads() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify([]));
      renderLeads();
    }

    // Initialize Lead Counter on Load
    renderLeads();
  </script>
