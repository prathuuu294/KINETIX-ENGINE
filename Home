<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Prathamesh Salunke | Luxury Web Architecture & CRM Studio (India)</title>

  <!-- Google Fonts: Inter (Apple-style UI) & JetBrains Mono (Nothing-style Telemetry) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    /* ==========================================
       1. THEME VARIABLES & RESET
       ========================================== */
    :root {
      --bg-dark: #070709;
      --bg-card: rgba(255, 255, 255, 0.04);
      --bg-card-hover: rgba(255, 255, 255, 0.08);
      --border-light: rgba(255, 255, 255, 0.1);
      --border-gold: rgba(212, 175, 55, 0.45);
      --text-main: #f5f5f7;
      --text-muted: #9496a1;
      --gold: #d4af37;
      --gold-light: #f3e5ab;
      --accent-blue: #38bdf8;
      --success: #22c55e;
      --radius: 20px;
      --transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      line-height: 1.6;
      overflow-x: hidden;
      background-image: 
        radial-gradient(circle at 15% 10%, rgba(212, 175, 55, 0.08), transparent 35%),
        radial-gradient(circle at 85% 30%, rgba(56, 189, 248, 0.06), transparent 35%);
    }

    /* Subtle Nothing-inspired dot grid background */
    .dot-bg {
      background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
      background-size: 24px 24px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .mono {
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: 0.05em;
    }

    /* ==========================================
       2. NAVIGATION BAR (Apple Frosted Glass)
       ========================================== */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(7, 7, 9, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-light);
    }

    .nav-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 76px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 700;
      font-size: 1.1rem;
      letter-spacing: -0.02em;
      text-decoration: none;
      color: var(--text-main);
    }

    .brand-mark {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--gold), #8a6d1b);
      color: #000;
      display: grid;
      place-items: center;
      font-weight: 800;
    }

    .india-badge {
      font-size: 0.7rem;
      padding: 4px 10px;
      border-radius: 99px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border-light);
      color: var(--gold-light);
    }

    .nav-links {
      display: flex;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: var(--transition);
    }

    .nav-links a:hover {
      color: var(--text-main);
    }

    .nav-actions {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    /* ==========================================
       3. BUTTONS
       ========================================== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 24px;
      border-radius: 99px;
      font-weight: 600;
      font-size: 0.9rem;
      text-decoration: none;
      cursor: pointer;
      border: 1px solid transparent;
      transition: var(--transition);
    }

    .btn-gold {
      background: linear-gradient(135deg, var(--gold-light), var(--gold));
      color: #050507;
      box-shadow: 0 8px 25px rgba(212, 175, 55, 0.25);
    }

    .btn-gold:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(212, 175, 55, 0.4);
    }

    .btn-outline {
      background: rgba(255, 255, 255, 0.04);
      color: var(--text-main);
      border: 1px solid var(--border-light);
    }

    .btn-outline:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: var(--gold);
    }

    /* ==========================================
       4. HERO SECTION
       ========================================== */
    .hero {
      padding: 100px 0 80px;
      text-align: center;
    }

    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      border-radius: 99px;
      background: rgba(212, 175, 55, 0.1);
      border: 1px solid var(--border-gold);
      color: var(--gold-light);
      font-size: 0.78rem;
      margin-bottom: 24px;
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      background: var(--success);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--success);
    }

    .hero h1 {
      font-size: clamp(2.4rem, 5.5vw, 4.4rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.1;
      max-width: 900px;
      margin: 0 auto 24px;
      background: linear-gradient(180deg, #ffffff 30%, #9496a1 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      color: var(--text-muted);
      font-size: 1.15rem;
      max-width: 680px;
      margin: 0 auto 36px;
    }

    .hero-buttons {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 64px;
    }

    .hero-metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      padding: 28px;
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: var(--radius);
      backdrop-filter: blur(12px);
    }

    .metric-box h3 {
      font-size: 1.8rem;
      color: var(--gold-light);
      font-weight: 700;
    }

    .metric-box p {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin: 4px 0 0;
    }

    /* ==========================================
       5. SECTION HEADINGS & BENTO GRID
       ========================================== */
    section {
      padding: 80px 0;
    }

    .section-header {
      text-align: center;
      max-width: 680px;
      margin: 0 auto 56px;
    }

    .section-tag {
      color: var(--gold);
      font-size: 0.8rem;
      text-transform: uppercase;
      margin-bottom: 10px;
      display: block;
    }

    .section-header h2 {
      font-size: clamp(1.8rem, 3.5vw, 2.75rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 14px;
    }

    .section-header p {
      color: var(--text-muted);
    }

    .bento-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 24px;
    }

    .bento-card {
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: var(--radius);
      padding: 32px;
      transition: var(--transition);
      position: relative;
      overflow: hidden;
    }

    .bento-card:hover {
      background: var(--bg-card-hover);
      border-color: var(--border-gold);
      transform: translateY(-4px);
    }

    .card-code {
      font-size: 0.75rem;
      color: var(--gold);
      margin-bottom: 14px;
      display: inline-block;
      padding: 4px 10px;
      background: rgba(212, 175, 55, 0.1);
      border-radius: 6px;
    }

    .bento-card h3 {
      font-size: 1.3rem;
      margin-bottom: 12px;
    }

    .bento-card p {
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-bottom: 20px;
    }

    .feature-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .feature-tags span {
      font-size: 0.75rem;
      padding: 4px 10px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.05);
      color: var(--text-main);
      border: 1px solid var(--border-light);
    }

    /* ==========================================
       6. INTERACTIVE SYSTEM PREVIEW
       ========================================== */
    .preview-box {
      background: rgba(15, 15, 20, 0.9);
      border: 1px solid var(--border-light);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
    }

    .preview-tabs {
      display: flex;
      gap: 10px;
      padding: 16px 24px;
      background: rgba(255, 255, 255, 0.03);
      border-bottom: 1px solid var(--border-light);
      flex-wrap: wrap;
    }

    .tab-btn {
      padding: 10px 18px;
      border-radius: 10px;
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-muted);
      cursor: pointer;
      font-weight: 600;
      font-size: 0.85rem;
      transition: var(--transition);
    }

    .tab-btn.active {
      background: rgba(212, 175, 55, 0.15);
      color: var(--gold-light);
      border-color: var(--border-gold);
    }

    .preview-content {
      padding: 36px;
      display: none;
    }

    .preview-content.active {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 24px;
    }

    .mock-widget {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-light);
      padding: 24px;
      border-radius: 14px;
    }

    .mock-widget h4 {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    .mock-widget .big-val {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 8px;
    }

    /* ==========================================
       7. DEVELOPER PROFILE SECTION
       ========================================== */
    .dev-card {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 40px;
      background: linear-gradient(145deg, rgba(255,255,255,0.05), rgba(255,255,255,0.01));
      border: 1px solid var(--border-gold);
      border-radius: var(--radius);
      padding: 48px;
      align-items: center;
    }

    .dev-role {
      color: var(--gold);
      font-size: 0.85rem;
      text-transform: uppercase;
      margin-bottom: 8px;
      display: block;
    }

    .dev-card h2 {
      font-size: 2.2rem;
      margin-bottom: 16px;
    }

    .dev-card p {
      color: var(--text-muted);
      margin-bottom: 24px;
    }

    .skill-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .skill-box {
      background: rgba(0, 0, 0, 0.45);
      border: 1px solid var(--border-light);
      padding: 20px;
      border-radius: 14px;
    }

    .skill-box h4 {
      color: var(--gold-light);
      font-size: 1.1rem;
      margin-bottom: 6px;
    }

    .skill-box p {
      font-size: 0.82rem;
      margin: 0;
    }

    /* ==========================================
       8. PRICING PLANS (INDIA EXCLUSIVE - INR)
       ========================================== */
    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 24px;
    }

    .price-card {
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: var(--radius);
      padding: 36px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: var(--transition);
    }

    .price-card.featured {
      border-color: var(--gold);
      background: linear-gradient(180deg, rgba(212, 175, 55, 0.09) 0%, rgba(255, 255, 255, 0.02) 100%);
      transform: scale(1.02);
    }

    .price-amount {
      font-size: 2.5rem;
      font-weight: 800;
      margin: 16px 0 8px;
      color: var(--text-main);
    }

    .price-amount span {
      font-size: 0.9rem;
      color: var(--text-muted);
      font-weight: 400;
    }

    .price-list {
      list-style: none;
      margin: 24px 0 32px;
    }

    .price-list li {
      margin-bottom: 12px;
      font-size: 0.92rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .price-list li::before {
      content: "✓";
      color: var(--gold);
      font-weight: bold;
    }

    /* ==========================================
       9. BOOKING FORM & ADMIN CRM MODAL
       ========================================== */
    .form-box {
      max-width: 720px;
      margin: 0 auto;
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      padding: 40px;
      border-radius: var(--radius);
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 20px;
    }

    label {
      display: block;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    input, select, textarea {
      width: 100%;
      padding: 14px;
      border-radius: 12px;
      border: 1px solid var(--border-light);
      background: rgba(0, 0, 0, 0.5);
      color: var(--text-main);
      font-family: inherit;
      font-size: 0.95rem;
    }

    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--gold);
    }

    /* Modal for Built-In Business CRM */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(10px);
      display: none;
      place-items: center;
      z-index: 200;
      padding: 20px;
    }

    .modal-overlay.open {
      display: grid;
    }

    .modal-window {
      background: #101015;
      border: 1px solid var(--border-gold);
      border-radius: var(--radius);
      width: 100%;
      max-width: 800px;
      padding: 32px;
      max-height: 85vh;
      overflow-y: auto;
    }

    .lead-item {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-light);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    footer {
      border-top: 1px solid var(--border-light);
      padding: 40px 0;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    @media (max-width: 768px) {
      .nav-links { display: none; }
      .dev-card, .form-grid { grid-template-columns: 1fr; }
      .price-card.featured { transform: none; }
    }
  </style>
</head>
